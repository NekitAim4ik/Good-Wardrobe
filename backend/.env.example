# Скопируйте в .env и заполните. Файл .env в git не попадает.
NODE_ENV=development
PORT=3000

# PostgreSQL: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dobry_shkaf?schema=public"

# Секрет подписи access-токенов, не короче 32 символов. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Время жизни access-токена (секунды) и «запомнить меня» для refresh-токена (дни)
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# Адреса фронтенда через запятую (для CORS)
CORS_ORIGIN=http://localhost:5173
